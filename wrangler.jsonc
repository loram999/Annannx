// Pre-create this file so `npx wrangler deploy` doesn't auto-generate
// a minimal one that ships node_modules (122 MiB workerd binary).
// https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "annannx",
  "compatibility_date": "2026-08-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Exclude everything that isn't an actual static asset — this is
    // what stops the 122 MiB node_modules/workerd/bin/workerd from
    // being shipped to Cloudflare.
    "exclude": [
      "node_modules/**",
      ".git/**",
      ".claude/**",
      "*.zip",
      "*.md",
      "vercel.json",
      "wrangler.jsonc",
      ".gitignore",
      "package.json",
      "package-lock.json",
      "bun.lockb"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
